{
  "name": "airtable-kit",
  "version": "0.0.27",
  "description": "A better ts/js airtable toolkit",
  "license": "MIT",
  "author": "Nick Crews",
  "repository": {
    "type": "git",
    "url": "https://github.com/NickCrews/airtable-kit"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": "./dist/src/bin.cjs",
  "exports": {
    "./fetcher": {
      "types": "./dist/src/fetcher.d.cts",
      "import": "./dist/src/fetcher.js",
      "require": "./dist/src/fetcher.cjs"
    },
    "./bases": {
      "types": "./dist/src/bases/index.d.cts",
      "import": "./dist/src/bases/index.js",
      "require": "./dist/src/bases/index.cjs"
    },
    "./tables": {
      "types": "./dist/src/tables/index.d.cts",
      "import": "./dist/src/tables/index.js",
      "require": "./dist/src/tables/index.cjs"
    },
    "./fields": {
      "types": "./dist/src/fields/index.d.cts",
      "import": "./dist/src/fields/index.js",
      "require": "./dist/src/fields/index.cjs"
    },
    "./value-converters": {
      "types": "./dist/src/value-converters/index.d.cts",
      "import": "./dist/src/value-converters/index.js",
      "require": "./dist/src/value-converters/index.cjs"
    },
    "./records": {
      "types": "./dist/src/records/index.d.cts",
      "import": "./dist/src/records/index.js",
      "require": "./dist/src/records/index.cjs"
    },
    "./mcp": {
      "types": "./dist/src/mcp/index.d.cts",
      "import": "./dist/src/mcp/index.js",
      "require": "./dist/src/mcp/index.cjs"
    },
    "./codegen": {
      "types": "./dist/src/codegen/index.d.cts",
      "import": "./dist/src/codegen/index.js",
      "require": "./dist/src/codegen/index.cjs"
    },
    "./formula": {
      "types": "./dist/src/formula/index.d.cts",
      "import": "./dist/src/formula/index.js",
      "require": "./dist/src/formula/index.cjs"
    },
    "./exceptions": {
      "types": "./dist/src/exceptions.d.cts",
      "import": "./dist/src/exceptions.js",
      "require": "./dist/src/exceptions.cjs"
    },
    "./validators": {
      "types": "./dist/src/validators/index.d.cts",
      "import": "./dist/src/validators/index.js",
      "require": "./dist/src/validators/index.cjs"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "cli": "pnpx tsx src/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "build": "zshy && cp README.md dist/README.md && cp LICENSE dist/LICENSE",
    "build:watch": "pnpx onchange@7.1.0 \"src/**\" -- pnpm run build",
    "pub": "npm run build && npm publish",
    "ensure-test-base": "pnpx tsx src/tests/test-base.ts"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv": "^17.2.3",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "~2.1.9",
    "zod": "^4",
    "zshy": "^0.4.4"
  },
  "zshy": {
    "bin": "./src/bin.ts",
    "exports": {
      "./fetcher": "./src/fetcher.ts",
      "./bases": "./src/bases/index.ts",
      "./tables": "./src/tables/index.ts",
      "./fields": "./src/fields/index.ts",
      "./value-converters": "./src/value-converters/index.ts",
      "./records": "./src/records/index.ts",
      "./mcp": "./src/mcp/index.ts",
      "./codegen": "./src/codegen/index.ts",
      "./formula": "./src/formula/index.ts",
      "./exceptions": "./src/exceptions.ts",
      "./validators": "./src/validators/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "dependencies": {
    "commander": "^14.0.3"
  }
}
